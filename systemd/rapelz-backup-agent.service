[Unit]
Description=Rapelz Backup Agent (manual job wrapper)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/rapelz-backup/agent.env
ExecStart=/usr/local/sbin/rapelz-backup-agent.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/rapelz-backup-agent /etc/rapelz-backup /var/log /run/lock /var/tmp
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
